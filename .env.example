ENV=dev
# true -> API terminal prints each orchestrator step (same as `make api-debug`)
DEBUG=false
# Conversations with no activity for this many hours are deleted (no accounts, no export yet)
CONVERSATION_TTL_HOURS=24
LITELLM_BASE_URL=http://localhost:4000
LLM_DEFAULT_MODEL=local-llm
# Host port for the Langfuse UI/API; change both if 3000 is taken on your machine.
LANGFUSE_PORT=3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=dev@ssa.local

OLLAMA_MODEL=qwen3:14b
EMBEDDING_MODEL=nomic-embed-text

# Passwords and keys: left blank here on purpose. `make up` creates .env with a random value
# for each (infra/make_env.py), so no install shares a password with another or with this repo.
# To replace the ones in an existing .env: `make new-secrets`.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://postgres:${POSTGRES_PASSWORD}@localhost:5433/ssa
LITELLM_MASTER_KEY=
LITELLM_ROUTER_KEY=
LITELLM_CATALOG_KEY=
LITELLM_CAREER_KEY=
# LiteLLM dashboard login (user admin), http://localhost:4000/ui
LITELLM_UI_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Langfuse login (with LANGFUSE_INIT_USER_EMAIL above)
LANGFUSE_INIT_USER_PASSWORD=
CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_PASSWORD=
